# MongoDB
MONGODB_URI=mongodb+srv://SEU_USUARIO:SUA_SENHA@SEU_CLUSTER/pacotinho_de_amor?retryWrites=true&w=majority

# URL pública do site usada nos links enviados pelo WhatsApp.
# Em teste local:
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Meta WhatsApp Cloud API - número DO PROJETO que envia as mensagens.
# O número de cada voluntário vem do campo phone do cadastro.
WHATSAPP_ACCESS_TOKEN=SEU_TOKEN_DA_META
WHATSAPP_PHONE_NUMBER_ID=SEU_PHONE_NUMBER_ID
WHATSAPP_API_VERSION=v23.0

# Nomes EXATOS dos templates aprovados no WhatsApp Manager.
WHATSAPP_TEMPLATE_FIRST_PHASE=pacotinho_primeira_fase
WHATSAPP_TEMPLATE_APPROVED=pacotinho_conta_criada
WHATSAPP_TEMPLATE_PASSWORD_RESET=pacotinho_recuperar_senha
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
